{
  "sites": [
    {
      "hostname": "www.sozorockfoundation.org",
      "source": "infra/cloudformation/parent-cloudfront.yml",
      "pages": ["/", "/platforms", "/platforms/health", "/workforce", "/ai-society", "/platforms/ai-lab", "/publications", "/publication/hsa-v1-2026", "/publication/rrg-v1-2025", "/publication/rebs-v1-2025", "/events", "/about", "/leadership", "/partner", "/support", "/contact", "/privacy", "/sitemap.xml", "/robots.txt", "/llms.txt"],
      "redirects": ["/platforms/applied-learning", "/platforms/institute", "/insights"],
      "error": { "path": "/__privacy_monitor_missing__", "statuses": [404] }
    },
    {
      "hostname": "sozorockfoundation.org",
      "source": "infra/cloudformation/parent-cloudfront.yml",
      "redirects": ["/", "/privacy"],
      "error": { "path": "/__privacy_monitor_missing__", "statuses": [404] }
    },
    {
      "hostname": "health.sozorockfoundation.org",
      "source": "drolu-cmyk/sozorock-health:apps/public-site/next.config.ts",
      "pages": ["/", "/work", "/explore", "/privacy", "/publications"],
      "redirects": ["/about"],
      "error": { "path": "/__privacy_monitor_missing__", "statuses": [404] }
    },
    {
      "hostname": "www.health.sozorockfoundation.org",
      "source": "drolu-cmyk/sozorock-health:apps/public-site/next.config.ts",
      "redirects": ["/", "/about"],
      "error": { "path": "/__privacy_monitor_missing__", "statuses": [404] }
    },
    {
      "hostname": "ai-lab.sozorockfoundation.org",
      "source": "drolu-cmyk/sozorock-ai-lab:.github/workflows/deploy-aws.yml",
      "pages": ["/", "/curriculum/", "/privacy/"],
      "error": { "path": "/__privacy_monitor_missing__", "statuses": [404] },
      "extraErrors": [{ "path": "/api/applications/start", "statuses": [404] }]
    },
    {
      "hostname": "cbcap.sozorockfoundation.org",
      "source": "drolu-cmyk/sozorock-health:.github/workflows/deploy-cbcap.yml",
      "pages": ["/", "/workspace"],
      "error": { "path": "/__privacy_monitor_missing__", "statuses": [404] }
    },
    {
      "hostname": "api.cbcap.sozorockfoundation.org",
      "source": "drolu-cmyk/sozorock-health:.github/workflows/deploy-cbcap.yml",
      "api": { "path": "/api/health", "statuses": [200, 401, 403, 404] },
      "error": { "path": "/__privacy_monitor_missing__", "statuses": [403, 404] }
    },
    {
      "hostname": "sozorockhealth.com",
      "source": "scripts/publish-legacy-health-redirect.mjs:legacyHosts",
      "redirects": ["/", "/about", "/cb-cap"],
      "error": { "path": "/api/contact", "statuses": [410] }
    },
    {
      "hostname": "www.sozorockhealth.com",
      "source": "scripts/publish-legacy-health-redirect.mjs:legacyHosts",
      "redirects": ["/", "/about", "/cb-cap"],
      "error": { "path": "/api/contact", "statuses": [410] }
    }
  ]
}
